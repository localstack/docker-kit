#!/usr/bin/env bash
# Maps localhost.localstack.cloud to loopback in the sandbox hosts file, so
# that the name resolves without DNS. The kit denies the name at the sandbox
# proxy, and sbx also refuses the DNS lookup of a denied name. The sandbox
# cannot use the LocalStack DNS server, because /etc/resolv.conf is read-only
# there.
#
# A hosts file has no wildcards, so subdomains such as
# s3.localhost.localstack.cloud get no entry in the sandbox.
#
# This must run as root.
set -euo pipefail

readonly HOSTS_ENTRY="127.0.0.1 localhost.localstack.cloud"

main() {
  grep -q -x -F "$HOSTS_ENTRY" /etc/hosts || echo "$HOSTS_ENTRY" >>/etc/hosts
}

main "$@"
