#!/usr/bin/env bash
# Runs the LocalStack MCP server on the Node.js runtime that this kit ships.
# The agent starts it as a stdio MCP server.
set -euo pipefail

readonly KIT_HOME=/opt/localstack-kit
readonly SERVER_ENTRY="$KIT_HOME/node/lib/node_modules/@localstack/localstack-mcp-server/dist/cli.js"
readonly STATE_DIR=/tmp/localstack-kit

# lskit-start records the container and image that lstk started. The MCP
# server must use the same ones, or it starts a second emulator. Before the
# first start, the server finds the LocalStack container by itself.
recorded() {
  head -n 1 "$STATE_DIR/$1" 2>/dev/null || true
}

main() {
  local container image
  container="$(recorded container-name)"
  image="$(recorded image)"
  if [[ -z "${MAIN_CONTAINER_NAME:-}" && -n "$container" ]]; then
    export MAIN_CONTAINER_NAME="$container"
  fi
  if [[ -z "${LOCALSTACK_IMAGE_NAME:-}" && -n "$image" ]]; then
    export LOCALSTACK_IMAGE_NAME="$image"
  fi
  export PATH="$KIT_HOME/bin:$KIT_HOME/node/bin:$PATH"
  exec node "$SERVER_ENTRY" "$@"
}

main "$@"
