#!/usr/bin/env bash
# Runs the LocalStack MCP server on the Node.js runtime that this kit ships.
# The agent starts it as a stdio MCP server.
set -euo pipefail

readonly KIT_HOME=/opt/localstack-kit
readonly SERVER_ENTRY="$KIT_HOME/node/lib/node_modules/@localstack/localstack-mcp-server/dist/cli.js"
readonly LSTK_CONFIG="$HOME/.config/lstk/config.toml"

# The MCP server and lstk must use the same image and container, or the MCP
# server starts a second emulator. The image comes from the lstk config that
# the kit writes at sandbox start.
lstk_image() {
  sed -n 's/^image = "\(.*\)"$/\1/p' "$LSTK_CONFIG" 2>/dev/null | head -n 1
}

export MAIN_CONTAINER_NAME="${MAIN_CONTAINER_NAME:-localstack-main}"
export LOCALSTACK_IMAGE_NAME="${LOCALSTACK_IMAGE_NAME:-$(lstk_image)}"
export PATH="$KIT_HOME/bin:$KIT_HOME/node/bin:$PATH"

exec node "$SERVER_ENTRY" "$@"
